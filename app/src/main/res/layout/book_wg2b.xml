                            android:textStyle="bold"
                            android:textSize="14sp"
                            android:text="@string/book_index02a_Ta9"/>
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/b10"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="5dp"
